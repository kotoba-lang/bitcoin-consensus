{:paths ["src"]
 :deps
 {org.clojure/clojure {:mvn/version "1.12.5"}
  io.github.kotoba-lang/org-bitcoin-p2p
  {:git/url "https://github.com/kotoba-lang/org-bitcoin-p2p.git"
   :git/tag "v0.5.2"
   :git/sha "112c1a589aa25f21a75a688fc6cfac521929b1d6"}
  io.github.kotoba-lang/sha256d
  {:git/url "https://github.com/kotoba-lang/sha256d.git"
   :git/sha "5fd4e64d0fc5a616b798edbca7327da33c78eb02"}
  io.github.kotoba-lang/btc-crypto
  {:git/url "https://github.com/kotoba-lang/btc-crypto.git"
   :git/sha "675f893826db1b01994c7ef9bf9002a2669d54da"}
  org.xerial/sqlite-jdbc {:mvn/version "3.53.2.0"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo
                        {:mvn/version "2025.10.23"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}
  :coverage {:extra-paths ["test"]
             :extra-deps {cloverage/cloverage {:mvn/version "1.2.4"}}
             :main-opts ["-m" "cloverage.coverage"
                         "-p" "src" "-s" "test"
                         "--no-html" "--text"
                         "--fail-threshold" "65"]}
  :core-vectors
  {:extra-paths ["test"]
   :extra-deps {org.clojure/data.json {:mvn/version "2.5.1"}}
   :main-opts ["-m" "bitcoin.consensus.core-vectors"]}}}
